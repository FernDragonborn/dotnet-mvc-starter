# --- API & APP CONFIG ---
CONNECTION_STRING="Data Source=app.db;Cache=Shared"
JWT_PRIVATE_KEY="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_AUDIENCE="your-web-app"
JWT_ISSUER="your-api"

# --- CORS (production only; comma-separated. Required when ASPNETCORE_ENVIRONMENT=Production) ---
ALLOWED_ORIGINS=

# --- STORAGE ---
STORAGE_PROVIDER=local
# Local backend
LOCAL_STORAGE_ROOT=./uploads
# S3 / S3-compatible backend (used when STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
